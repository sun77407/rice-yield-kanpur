# Copy to .env (never commit .env)

# Google Earth Engine (Nirma University academic non-commercial, Community tier)
GEE_PROJECT=your-gee-cloud-project-id
# Optional: service account auth instead of interactive `earthengine authenticate`
GEE_SERVICE_ACCOUNT=
GEE_PRIVATE_KEY_FILE=

# Copernicus CDS API (ERA5-Land): https://cds.climate.copernicus.eu/how-to-api
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=

# Local LLM / embeddings (ADR-007, ADR-008)
OLLAMA_HOST=http://localhost:11434
LLM_PRIMARY=qwen2.5:14b-instruct-q6_K
LLM_FALLBACK=llama3:latest
EMBED_MODEL=nomic-embed-text

# GEE quota guard (Community tier = 150 EECU-hours)
GEE_QUOTA_EECU_HOURS=150

# ADR-016 (post-sprint)
USE_LIVE_FORECAST=false
